yer3" value="TẦNG 2 · MÔ HÌNH HÓA PHÂN TÍCH (ML + ƯU TIÊN)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#EAF6F4;strokeColor=#1E8449;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#145A32;" vertex="1" parent="1"><mxGeometry x="450" y="105" width="430" height="465" as="geometry"/></mxCell><mxCell id="layer4" value="TẦNG 3 · TƯƠNG TÁC RA QUYẾT ĐỊNH (Power BI Desktop · Trang 5)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#FDF2E9;strokeColor=#B9770E;fontFamily=Times New Roman;fontSize=13;fontStyle=1;fontColor=#7E5109;" vertex="1" parent="1"><mxGeometry x="920" y="105" width="430" height="465" as="geometry"/></mxCell><mxCell id="bandtitle" value="BỐN CẤP ĐỘ HỖ TRỢ RA QUYẾT ĐỊNH (TPS → MIS → DSS → EIS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="50" y="615" width="900" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Luồng một chiều từ dữ liệu → mô hình → quyết định; vòng phản hồi chỉ cập nhật kho dữ liệu và mô hình, không ghi ngược vào Power BI. Nguồn: nhóm SkyOps." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=9.5;fontColor=#5B6573;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="745" width="1280" height="22" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Nguồn thô&lt;/b&gt;&lt;br&gt;flights_sample_3m.csv (BTS) · 3.000.000 dòng&lt;br&gt;+ thời tiết Open-Meteo · múi giờ IANA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F2F3F4;strokeColor=#566573;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#566573;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer2"><mxGeometry x="20" y="48" width="320" height="62" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;dbt-duckdb · kho phân tích&lt;/b&gt;&lt;br&gt;staging → intermediate → marts (2022–08/2023)&lt;br&gt;1.151.344 FactFlight · 6 Dimension · 46 test" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D6EAF8;strokeColor=#1F618D;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#1F618D;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer2"><mxGeometry x="20" y="135" width="320" height="88" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Feature engineering tiền sự kiện (DuckDB SQL)&lt;/b&gt;&lt;br&gt;CRS + lịch sử ≤ D-1 · thời tiết ngày · tàu bay inbound&lt;br&gt;nowcast sân bay + mạng lưới (UTC) tại T-60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D6EAF8;strokeColor=#1F618D;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#1F618D;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer2"><mxGeometry x="20" y="248" width="320" height="86" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Feature store tiền sự kiện&lt;/b&gt;&lt;br&gt;280 biến · mỗi biến có mốc known_time ≤ T_pred&lt;br&gt;features_v8 · nowcast_h60 · network_h60" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ABEBC6;strokeColor=#196F3D;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#196F3D;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer2"><mxGeometry x="20" y="360" width="320" height="70" as="geometry"/></mxCell><mxCell id="e9" value="dbt build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F618D;strokeWidth=1.6;endArrow=block;endFill=1;fontFamily=Times New Roman;fontSize=9;fontColor=#1F618D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="layer2" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="feature table" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F618D;strokeWidth=1.6;endArrow=block;endFill=1;fontFamily=Times New Roman;fontSize=9;fontColor=#1F618D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="layer2" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="build features" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F618D;strokeWidth=1.6;endArrow=block;endFill=1;fontFamily=Times New Roman;fontSize=9;fontColor=#1F618D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="layer2" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="&lt;b&gt;dss_delay_prediction.ipynb&lt;/b&gt;&lt;br&gt;Train ≤04/2023 · Val 05–06 · Test 07–08/2023&lt;br&gt;Colab GPU / Velura RTX 4060 · seed 42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E9EDF4;strokeColor=#4A5568;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#4A5568;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer3"><mxGeometry x="20" y="48" width="390" height="62" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;ANTI-LEAKAGE GATE&lt;/b&gt;&lt;br&gt;Chỉ dùng sự kiện đã biết trước T_pred = CRS_DEP − 60 phút&lt;br&gt;Cấm DEP/ARR_DELAY, TAXI, AIR_TIME, CANCELLED, DELAY_DUE_* của chính chuyến" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FBEDEC;strokeColor=#B03A2E;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=10.5;fontColor=#B03A2E;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer3"><mxGeometry x="20" y="135" width="390" height="78" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Ensemble XGBoost GPU + LightGBM → Isotonic&lt;/b&gt;&lt;br&gt;Mục tiêu: FAA arrival delay ≥ 15 phút&lt;br&gt;Delay_Probability 0.00–1.00 đã hiệu chỉnh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#1E8449;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer3"><mxGeometry x="20" y="240" width="390" height="78" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Thuật toán ưu tiên&lt;/b&gt;&lt;br&gt;Priority = 100 · P · (0,5 + 0,5 · Impact)&lt;br&gt;Ma trận Rủi ro × Tác động → P1–P4 · hành động" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#B9770E;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer3"><mxGeometry x="20" y="345" width="390" height="80" as="geometry"/></mxCell><mxCell id="e16" value="feature matrix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#196F3D;strokeWidth=1.6;endArrow=block;endFill=1;fontFamily=Times New Roman;fontSize=9;fontColor=#196F3D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="layer3" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="train / validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#196F3D;strokeWidth=1.6;endArrow=block;endFill=1;fontFamily=Times New Roman;fontSize=9;fontColor=#196F3D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="layer3" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="probability" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#196F3D;strokeWidth=1.6;endArrow=block;endFill=1;fontFamily=Times New Roman;fontSize=9;fontColor=#196F3D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="layer3" source="n14" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="&lt;b&gt;Power BI Desktop · Trang 5&lt;/b&gt;&lt;br&gt;Nguồn: DSS_Flight_Prediction.csv&lt;br&gt;cảnh báo sớm · danh sách chuyến ưu tiên" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8DAEF;strokeColor=#6C3483;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#6C3483;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer4"><mxGeometry x="20" y="48" width="390" height="70" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Tương tác quyết định&lt;/b&gt;&lt;br&gt;Danh sách P1 · ma trận ưu tiên · slicer ngưỡng&lt;br&gt;drill-through chuyến · hãng · sân bay" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8DAEF;strokeColor=#6C3483;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#6C3483;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer4"><mxGeometry x="20" y="145" width="390" height="86" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Hành động điều hành&lt;/b&gt;&lt;br&gt;Đổi giờ · điều phối tàu · phân bổ nguồn lực&lt;br&gt;ưu tiên theo mức tác động" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDEBD0;strokeColor=#B9770E;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#B9770E;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="layer4"><mxGeometry x="20" y="260" width="390" height="76" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Theo dõi &amp; phản hồi&lt;/b&gt;&lt;br&gt;Actual_Delayed15 vs dự báo · drift AUC/tháng&lt;br&gt;human-in-the-loop · retrain định kỳ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F2F3F4;strokeColor=#566573;strokeWidth=1.4;fontFamily=Times New Roman;fontSize=11;fontColor=#566573;verticalAlign=top;spacingTop=6;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=5 5;" vertex="1" parent="layer4"><mxGeometry x="20" y="365