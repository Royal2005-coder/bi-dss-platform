star_delay: "Star schema — FactDelayReason (2022–2023)" {
  grid-rows: 2
  grid-columns: 3
  grid-gap: 44
  style: {
    fill: "#ffffff"
    stroke: "#cfd8dc"
    stroke-width: 1
    font-size: 22
    font-color: "#263238"
  }

  DimDate: {
    shape: sql_table
    date_key: int {constraint: primary_key}
    year: int
    month: int
    is_weekend: boolean
    style: {fill: "#c8e6c9"; stroke: "#e8f5e9"; font-size: 18; font-color: "#1b5e20"}
  }
  DimCarrier: {
    shape: sql_table
    carrier_key: int {constraint: primary_key}
    carrier_code: varchar
    carrier_name: varchar
    style: {fill: "#c8e6c9"; stroke: "#e8f5e9"; font-size: 18; font-color: "#1b5e20"}
  }
  DimAirport: {
    shape: sql_table
    airport_key: int {constraint: primary_key}
    airport_code: varchar
    region: varchar
    style: {fill: "#c8e6c9"; stroke: "#e8f5e9"; font-size: 18; font-color: "#1b5e20"}
  }

  DimDelayReason: {
    shape: sql_table
    delay_reason_key: int {constraint: primary_key}
    delay_reason_code: varchar
    style: {fill: "#e1bee7"; stroke: "#f3e5f5"; font-size: 18; font-color: "#4a148c"}
  }
  FactDelayReason: {
    shape: sql_table
    delay_fact_key: bigint {constraint: primary_key}
    flight_key: bigint {constraint: foreign_key}
    date_key: int {constraint: foreign_key}
    carrier_key: int {constraint: foreign_key}
    origin_airport_key: int {constraint: foreign_key}
    delay_reason_key: int {constraint: foreign_key}
    style: {fill: "#bbdefb"; stroke: "#e3f2fd"; font-size: 18; font-color: "#0d47a1"}
  }
  Legend: {
    shape: text
    label: "PK: khóa chính\nFK: khóa ngoại\nN:1: fact → dimension\nFlightKey: drill-through → FactFlight"
    style: {font-size: 15; font-color: "#455a64"}
  }
}

star_delay.FactDelayReason.date_key -> star_delay.DimDate.date_key: N:1 {
  style: {stroke: "#2e7d32"; stroke-width: 2; font-size: 14}
  target-arrowhead: {shape: triangle; style: {fill: "#2e7d32"}}
}
star_delay.FactDelayReason.carrier_key -> star_delay.DimCarrier.carrier_key: N:1 {
  style: {stroke: "#2e7d32"; stroke-width: 2; font-size: 14}
  target-arrowhead: {shape: triangle; style: {fill: "#2e7d32"}}
}
star_delay.FactDelayReason.origin_airport_key -> star_delay.DimAirport.airport_key: N:1 {
  style: {stroke: "#2e7d32"; stroke-width: 2; font-size: 14}
  target-arrowhead: {shape: triangle; style: {fill: "#2e7d32"}}
}
star_delay.FactDelayReason.delay_reason_key -> star_delay.DimDelayReason.delay_reason_key: N:1 {
  style: {stroke: "#6a1b9a"; stroke-width: 2; font-size: 14}
  target-arrowhead: {shape: triangle; style: {fill: "#6a1b9a"}}
}
